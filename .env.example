# Bot token from the Discord Developer Portal (Bot tab). Keep it secret.
DISCORD_TOKEN=
# Application ID from the Developer Portal (General Information tab).
DISCORD_CLIENT_ID=
# Optional. When set, slash commands register to this one server instantly
# instead of globally (global registration can take up to an hour to appear).
DISCORD_GUILD_ID=
# Optional. Comma-separated channel IDs where /lobby is allowed. Empty = any channel.
LFS_CHANNEL_IDS=
# Optional. Minutes before an unfilled lobby expires. Default 90.
LFS_LOBBY_TTL_MINUTES=90
# Optional. Minutes a full lobby (and its voice room) stays up after the last seat fills. Default 240.
LFS_FULL_LOBBY_TTL_MINUTES=240
# Optional. Where the SQLite database lives. Default ./data/lfs.sqlite
LFS_DB_PATH=./data/lfs.sqlite
# Optional. Create a private voice channel for each crew once a crewmate joins. Default on.
# Needs the bot to have Manage Channels, Manage Roles, Connect and Speak (see the README install link).
LFS_VOICE_ROOMS=on
# Optional. Category ID to put crew voice rooms under. When empty, LFS looks for a category
# named LFS_VOICE_CATEGORY_NAME and creates it if the server has none.
LFS_VOICE_CATEGORY_ID=
# Optional. Category name used when LFS_VOICE_CATEGORY_ID is empty. Default "LFS Voice".
LFS_VOICE_CATEGORY_NAME=LFS Voice
