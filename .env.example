# Bot token from the Discord Developer Portal (Bot tab). Keep it secret.
DISCORD_TOKEN=
# Application ID from the Developer Portal (General Information tab).
DISCORD_CLIENT_ID=
# Optional. When set, slash commands register to this one server instantly
# instead of globally (global registration can take up to an hour to appear).
DISCORD_GUILD_ID=
# Optional. Comma-separated channel IDs where /lobby is allowed. Empty = any channel.
LFS_CHANNEL_IDS=
# Optional. Minutes before an unfilled lobby expires. Default 90.
LFS_LOBBY_TTL_MINUTES=90
# Optional. Where the SQLite database lives. Default ./data/lfs.sqlite
LFS_DB_PATH=./data/lfs.sqlite
